# Required — URL of the deployed FastAPI backend (no trailing slash).
# Local dev default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — used for sitemap.xml and Open Graph URLs. Set to the real
# production domain once deployed (e.g. https://sensei-ai.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required — from a free Clerk project (clerk.com). See README for setup
# steps. Publishable key is safe to expose client-side; secret key is not
# — never commit .env.local (it's gitignored) or share the secret key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
