# Required — URL of the deployed FastAPI backend (no trailing slash).
# Local dev default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — used for sitemap.xml and Open Graph URLs. Set to the real
# production domain once deployed (e.g. https://sensei-ai.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
